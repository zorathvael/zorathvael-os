# Zorathvael OS Environment Configuration Example
# Copy this file to .env and fill in your actual API keys and secrets.

# AI Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
NOTEBOOKLM_API_KEY=your_notebooklm_api_key_here

# System Configuration
ZORATHVAEL_ENV=production
LOG_LEVEL=INFO
MEMORY_STORAGE_PATH=data/memory.db
WORKFLOW_TIMEOUT_SECONDS=300

# Payment / settlement destinations
ZORATHVAEL_QRIS_IMAGE=assets/payment_qris_reference.txt
ZORATHVAEL_USDT_BEP20_ADDRESS=0x4ce7004e7127f8b2386eb355e088f127c24b3fac

# Revenue acquisition — public-contact email transport
ZORATHVAEL_SMTP_HOST=smtp.example.com
ZORATHVAEL_SMTP_PORT=587
ZORATHVAEL_SMTP_USERNAME=your_sender_username
ZORATHVAEL_SMTP_PASSWORD=your_sender_password
ZORATHVAEL_EMAIL_FROM=your_sender@example.com

# Revenue learning — inbox response observer
ZORATHVAEL_IMAP_HOST=imap.example.com
ZORATHVAEL_IMAP_PORT=993
ZORATHVAEL_IMAP_USERNAME=your_inbox_username
ZORATHVAEL_IMAP_PASSWORD=your_inbox_password
