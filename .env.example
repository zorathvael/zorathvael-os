# Zorathvael OS Environment Configuration Example
# Copy this file to .env and fill in your actual API keys and secrets.

# AI Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
NOTEBOOKLM_API_KEY=your_notebooklm_api_key_here

# System Configuration
ZORATHVAEL_ENV=production
LOG_LEVEL=INFO
MEMORY_STORAGE_PATH=data/memory.db
WORKFLOW_TIMEOUT_SECONDS=300

# Payment / settlement destinations
ZORATHVAEL_QRIS_IMAGE=assets/payment_qris_reference.txt
ZORATHVAEL_USDT_BEP20_ADDRESS=0x4ce7004e7127f8b2386eb355e088f127c24b3fac
